/target

# Captured meeting audio — NEVER commit (private recordings).
# Glob the directory, not just *.wav: a scratch capture dir also accumulates transcripts
# and run logs, which the *.wav rule would not cover.
/capture*
*.wav

# Local SQLite store — default lives in ~/.meetscribe/; guard any repo-local --db override
*.db
*.db-journal

# User config — default lives in ~/.meetscribe/config.toml. Anchored to the repo root because
# a blanket *.toml would swallow Cargo.toml. Guards a scratch config dropped here while
# testing: it carries the [vocab] glossary, i.e. real terms from private meetings.
/config.toml

# ASR model artifacts — large binaries, provisioned via models/provision.sh
/models/*.bin
/models/*.mlmodelc/
/models/*.zip
/models/__MACOSX/
